[Unit]
Description=Cowrie TTY log uploader for ThreatMap session replay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=BACKEND_URL=https://threatmap.homelab.marmilan.com
ExecStart=/usr/bin/python3 /home/ubuntu/cowrie-tty-uploader.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
